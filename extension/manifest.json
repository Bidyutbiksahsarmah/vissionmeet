{
  "manifest_version": 3,
  "name": "VisionMeet",
  "version": "1.0.0",
  "description": "Capture meeting tab audio and extract action items directly into VisionMeet.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VisionMeet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabCapture",
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
